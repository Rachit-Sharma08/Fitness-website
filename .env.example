# Copy this file to .env and fill in the values for local development.
# On Replit, these are injected automatically — you don't need this file there.

# Server config
NODE_ENV=development
PORT=8080

# Comma-separated list of allowed frontend origins for CORS.
# Leave empty to allow all (default). On production set to your Vercel URL:
# ALLOWED_ORIGIN=https://infinity-fitness.vercel.app
ALLOWED_ORIGIN=

# Gmail app password for the contact form (Nodemailer).
# Generate one at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# Express session secret — any long random string works locally.
SESSION_SECRET=

# AI chatbot (Groq API)
# Get a key at https://console.groq.com
GROQ_API_KEY=

# Text-to-speech (Cartesia API)
# Get a key at https://dashboard.cartesia.ai
CARTESIA_API_KEY=

# ── Email auto-reply (customer) ──
# Brevo HTTP API is the ONLY provider that can email the CUSTOMER's auto-reply
# to any address. Resend's free onboarding@resend.dev sender can ONLY reach the
# account owner email. So for the customer auto-reply to work you MUST set a
# verified Brevo API key + sender email.
# Get a key at https://app.brevo.com (free plan: 300 emails/day).
# BREVO_SENDER_EMAIL must be a domain/address verified in Brevo's dashboard.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# ── Owner notification fallback ──
RESEND_API_KEY=

# Optional — only needed if you start using the database (schema is currently empty)
DATABASE_URL=

# Frontend (only used at build time on Vercel — local dev uses the Vite proxy)
# VITE_API_URL=https://your-render-backend.onrender.com
