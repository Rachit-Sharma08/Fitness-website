# Server config
NODE_ENV=production
PORT=8080

# Comma-separated list of allowed frontend origins for CORS.
# Leave empty to allow all (default). On production set to your Vercel URL:
# ALLOWED_ORIGIN=https://infinity-fitness.vercel.app
ALLOWED_ORIGIN=

# Secrets (NEVER commit real values — set these in the Render dashboard)
GMAIL_APP_PASSWORD=
SESSION_SECRET=
GROQ_API_KEY=
CARTESIA_API_KEY=

# ── Customer auto-reply email ──
# Brevo is the ONLY provider that can email the customer auto-reply to any
# address (Resend's free plan can only reach the owner). So this is REQUIRED
# for the auto-reply to work. Sender email must be verified in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# ── Owner notification fallback ──
RESEND_API_KEY=

# Optional — only needed if you start using the database (schema is currently empty)
DATABASE_URL=
